# --- Общие ---
APP_NAME=AI Agents API
APP_ENV=production

# --- База данных (для контейнера db) ---
# Эти три переменные Docker использует, чтобы создать БД.
POSTGRES_DB=ai_agents
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=ПридумайтеНадёжныйПароль123

# ВАЖНО: DATABASE_URL сюда писать НЕ НУЖНО. 
# docker-compose.yml сам подставит правильный адрес (db:5432) внутри сети Docker.

# --- Qwen / llama.cpp ---
# QWEN_BASE_URL тоже подставляется в docker-compose.yml (http://qwen:8080), 
# поэтому здесь его можно не указывать. Если укажете, он перебьет docker-compose!
QWEN_MODEL=
QWEN_TIMEOUT=300
QWEN_MAX_TOKENS=4096
QWEN_TEMPERATURE=0.2
# QWEN_API_KEY=

# --- Документы ---
# /app/var/documents — это путь ВНУТРИ контейнера. Не меняйте его.
DOCUMENTS_DIR=/app/var/documents
DOCUMENTS_MAX_FILE_MB=20

# --- RAG и эмбеддинги ---
# EMBEDDING_BASE_URL также подставляется автоматически (http://tei:80)
RAG_TOP_K=4
RAG_MAX_DISTANCE=0.35
CHUNK_SIZE=500
CHUNK_TOLERANCE=200
CHUNK_OVERLAP=100
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIMENSION=768

# --- Безопасность ---
# ОБЯЗАТЕЛЬНО замените на свою строку! 
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=ЗаменитеМеняНаДлиннуюСлучайнуюСтроку